    <!-- Why a connection failed -->
    <string name="failure_unreachable_title">Couldn’t reach %1$s</string>
    <string name="failure_unreachable_body">Check that the PC is on, Telepad is running, and both devices are on the same network.</string>
    <string name="failure_not_paired_title">%1$s hasn’t accepted this phone</string>
    <string name="failure_not_paired_body">The PC only accepts new phones while pairing is open. In the Telepad window on the PC, type pair, then try again.</string>
    <string name="failure_key_changed_title">%1$s has changed</string>
    <string name="failure_key_changed_body">It answers with a different identity than the one that was paired.</string>
    <string name="failure_handshake_title">Couldn’t secure the connection</string>
    <string name="failure_handshake_body">%1$s answered, but a secure connection couldn’t be set up. Try again. If it keeps happening, forget the PC and pair it again.</string>
    <string name="failure_lost_title">Lost connection to %1$s</string>
    <string name="failure_lost_body">It stopped answering. Check that the PC is awake and on the same network.</string>
    <string name="failure_bt_unsupported_title">Bluetooth keyboard isn’t available</string>
    <string name="failure_bt_unsupported_body">This phone can’t act as a Bluetooth keyboard and mouse. Use Wi‑Fi instead.</string>
    <string name="failure_bt_disabled_title">Bluetooth is off</string>
    <string name="failure_bt_disabled_body">Turn Bluetooth on, then try again.</string>
    <string name="failure_bt_permission_title">Bluetooth permission needed</string>
    <string name="failure_bt_permission_body">Telepad needs permission to talk to your paired Bluetooth devices.</string>
    <string name="failure_bt_failed_title">Couldn’t connect over Bluetooth</string>
    <string name="failure_bt_failed_body">Make sure %1$s has been paired with this phone in its Bluetooth settings, and that no other app is using the Bluetooth keyboard role.</string>

    <!-- Pairing -->
    <string name="pairing_contacting">Contacting %1$s…</string>
    <string name="pairing_verify_title">Verify this PC</string>
    <string name="pairing_verify_body">Check that this code matches the one in the Telepad window on %1$s.</string>
    <string name="pairing_verify_warning">If it doesn’t, don’t continue: something else on the network may be answering.</string>
    <string name="pairing_matches">They match</string>
    <string name="pairing_connecting">Connecting…</string>
    <string name="pairing_changed_title">%1$s has a new identity</string>
    <string name="pairing_changed_body">This PC was paired before, but it now answers with a different key. That happens if Telepad was reinstalled on it. It can also mean something else on the network is pretending to be it.</string>
    <string name="pairing_changed_advice">Continue only if you reinstalled Telepad on this PC and this code matches the one it shows now.</string>
    <string name="pairing_changed_continue">Trust the new key</string>
    <string name="pairing_not_paired_title">%1$s doesn’t know this phone yet</string>
    <string name="pairing_not_paired_body" tools:ignore="TypographyDashes">For safety a PC only accepts new phones while pairing is open. In the Telepad window on the PC, type pair (or start it with --pair), then try again.</string>
    <string name="pairing_security_note">Pairing happens once. Everything sent afterwards is encrypted.</string>

