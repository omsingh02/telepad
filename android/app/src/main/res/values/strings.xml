    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Your phone, your PC’s trackpad</string>
    <string name="onboarding_welcome_body">Move the pointer, click, type and control media on your computer from here. Fast, private, no account.</string>
    <string name="onboarding_install_title">Install Telepad on your PC</string>
    <string name="onboarding_install_body">A small free app on your computer receives what you do on the phone. It runs on Windows, macOS and Linux.</string>
    <string name="onboarding_network_title">Same Wi‑Fi, then a quick check</string>
    <string name="onboarding_network_body">Put both devices on the same network. The first time, you compare a short code on the phone with the one on the PC. That is what keeps strangers out.</string>
