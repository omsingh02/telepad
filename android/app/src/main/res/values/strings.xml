    <string name="privacy_forget_all">Forget all PCs</string>
    <string name="privacy_forget_all_title">Forget all paired PCs?</string>
    <string name="privacy_forget_all_body">You will verify each PC’s fingerprint again to reconnect.</string>
    <string name="privacy_identity_title">This phone’s identity</string>
    <string name="privacy_identity_body">Each PC recognizes this phone by a secret key stored only on it. Replacing the key makes this phone a stranger to every PC: each will have to pair with it again.</string>
    <string name="privacy_identity_reset">Replace the key</string>
    <string name="privacy_identity_reset_title">Replace this phone’s key?</string>
    <string name="privacy_identity_reset_body">Every PC will have to pair with this phone again. Do this only if you think the phone’s data was exposed.</string>

