<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network: UDP to the PC. The internet is used for one thing: asking GitHub for the list of Telepad's
         releases (and, when you tap Install, fetching one file), from Settings > About. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Lets the phone hear the PC's announcements, which arrive by multicast. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Keeps the Wi-Fi radio in low-latency mode while connected. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Bluetooth keyboard and mouse. Android 12+ asks for this at runtime, only when the
         Bluetooth tab is used. Nothing is scanned for and no location is involved. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <!-- The camera, only to read the QR code on the PC's screen, and only while the scanner is open.
         It asks at that moment, with the reason on screen. Nothing is recorded or sent. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Installing an update that Settings > About downloaded, when you tap Install. Android asks you to allow
         it for Telepad separately, and checks that the new file is signed with the same key as this app. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Staying connected in the background (optional, off by default). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Wi-Fi and Bluetooth are both optional: either one is enough. -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <!-- A phone without a camera can still add a PC by its address or over Bluetooth. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".TelepadApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Telepad.Starting"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize|density"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The link in a pairing QR code (telepad://pair?...): a camera app that opens links, or
                 a message with the link in it, takes the phone straight to pairing. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="telepad" android:host="pair" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.TelepadConnectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- The system installer's answer to an update (a question for the person, or how it ended). -->
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />

    </application>

</manifest>
